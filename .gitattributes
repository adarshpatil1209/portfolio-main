# Auto detect text files and perform LF normalization
* text=auto

# Binary files - never apply line ending conversion
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.ogg binary
*.mp3 binary
*.zip binary

